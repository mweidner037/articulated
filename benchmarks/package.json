{
  "name": "benchmarks",
  "private": true,
  "dependencies": {
    "@automerge/automerge": "^3.5.0",
    "@stdlib/stats-base-dists-t-quantile": "^0.2.3",
    "@types/seedrandom": "^3.0.8",
    "articulated": "workspace:*",
    "fflate": "^0.8.2",
    "maybe-random-string": "^1.0.0",
    "prosemirror-model": "^1.25.11",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.1",
    "protobufjs": "^8.8.1",
    "rope-sequence": "^1.3.4",
    "seedrandom": "^3.0.5",
    "yjs": "^13.6.33"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "worker": "tsx src/worker.ts",
    "results": "tsx src/results.ts",
    "proto": "pbjs -t static-module -w esm --force-number --no-verify --no-convert --no-delimited --no-typeurl -o src/generated/id_list_protobuf.js src/algorithms/id_list_protobuf.proto && pbts --main -i \"\\$protobuf=protobufjs\" -o src/generated/id_list_protobuf.d.ts src/generated/id_list_protobuf.js",
    "finish-trace": "tsx src/internal/finish_trace.ts",
    "lint": "pnpm run \"/^lint:.*/\"",
    "lint:tsc": "tsc -p tsconfig.dev.json",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier . --check",
    "format": "prettier . --write",
    "clean": "rm -rf build docs coverage .nyc_output"
  },
  "devDependencies": {
    "protobufjs-cli": "^2.7.1"
  }
}
