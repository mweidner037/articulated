{
  "name": "benchmarks",
  "private": true,
  "dependencies": {
    "@automerge/automerge": "^3.5.0",
    "@stdlib/stats-base-dists-t-quantile": "^0.2.3",
    "@types/seedrandom": "^3.0.8",
    "articulated": "workspace:*",
    "bson": "7.3.2",
    "fflate": "^0.8.2",
    "maybe-random-string": "^1.0.0",
    "mongodb": "7.1.0",
    "prosemirror-model": "^1.25.11",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.1",
    "prosemirror-view": "1.41.6",
    "protobufjs": "^8.8.1",
    "rope-sequence": "^1.3.4",
    "seedrandom": "^3.0.5",
    "yjs": "^13.6.33"
  },
  "scripts": {
    "explore:run": "node --import tsx src/browser/exploration-run.ts",
    "explore:sessions": "node --import tsx src/browser/session-run.ts",
    "explore:scale": "node --import tsx src/browser/exploration-scale.ts",
    "explore:canonical": "node --import tsx src/browser/canonical-run.ts",
    "explore:mongo": "node --import tsx src/browser/exploration-mongo.ts",
    "explore:report": "node --import tsx src/browser/exploration-report.ts && prettier exploration.md --write",
    "test": "TSX_TSCONFIG_PATH=tsconfig.dev.json node --import tsx --test src/full_picture/codecs.test.ts src/browser/*.test.ts",
    "browser:run": "node --import tsx src/browser/run.ts",
    "browser:mongo": "node --import tsx src/browser/mongo.ts",
    "browser:report": "node --import tsx src/browser/report.ts && prettier browser.md --write",
    "native:run": "node --import tsx src/browser/native-run.ts",
    "native:audit": "node --import tsx src/browser/edit-audit.mjs",
    "native:report": "node --import tsx src/browser/native-report.ts && prettier native.md --write",
    "full-picture:js": "node --expose-gc --import tsx src/full_picture/js.ts",
    "full-picture:mongo": "node --import tsx src/full_picture/mongo.ts",
    "full-picture:report": "node --import tsx src/full_picture/report.ts && prettier full_picture.md --write",
    "full-picture:test": "node --import tsx --test src/full_picture/codecs.test.ts",
    "start": "tsx src/main.ts",
    "worker": "tsx src/worker.ts",
    "results": "tsx src/results.ts",
    "proto": "pbjs -t static-module -w esm --force-number --no-verify --no-convert --no-delimited --no-typeurl -o src/generated/id_list_saved_state.js src/algorithms/id_list_saved_state.proto && pbts --main -i \"\\$protobuf=protobufjs\" -o src/generated/id_list_saved_state.d.ts src/generated/id_list_saved_state.js",
    "finish-trace": "tsx src/internal/finish_trace.ts",
    "lint": "pnpm run \"/^lint:.*/\"",
    "lint:tsc": "tsc -p tsconfig.dev.json",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier . --check",
    "format": "prettier . --write",
    "clean": "rm -rf build docs coverage .nyc_output"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright": "1.62.1",
    "protobufjs-cli": "^2.7.1"
  }
}
