// Run only against an isolated local benchmark server, from the repo root:
// ARTICULATED_BENCH_DBPATH=/absolute/temp/dbpath mongosh --quiet \
//   mongodb://127.0.0.1:27184/admin --file benchmarks/mongo-signed-counts.mongosh
// Requires npm run build. Never drops data; checks any completed fixture on resume.
(async () => {
  const assert = require("node:assert/strict");
  const fs = require("node:fs");
  const path = require("node:path");
  const crypto = require("node:crypto");
  const root = process.cwd();
  const {
    IdList,
    ElementIdGenerator,
    ColumnarIdList,
    BitPackedIdList,
  } = require(path.join(root, "build/commonjs"));
  const expectedPath = process.env.ARTICULATED_BENCH_DBPATH;
  assert(expectedPath && path.isAbsolute(expectedPath));
  const admin = db.getSiblingDB("admin");
  const opts = await admin.runCommand({ getCmdLineOpts: 1 });
  assert.equal(opts.parsed.storage.dbPath, expectedPath);
  assert.equal(opts.parsed.net.port, 27184);
  assert.equal(opts.parsed.net.bindIp, "127.0.0.1");
  const bench = db.getSiblingDB("articulated_signed_count_bench");
  const existing = await bench.getCollectionNames();
  assert(
    existing.every((name) =>
      /^(none|snappy|zstd)_(objects|signed_count_objects|columns_binary|bitpacked_columns)$/.test(
        name
      )
    )
  );

  let next = 0;
  let list = IdList.new();
  const id = (seed) =>
    crypto
      .createHash("sha256")
      .update(seed)
      .digest()
      .toString("base64url")
      .slice(0, 8);
  const generator = new ElementIdGenerator(() => id("bunch-" + next++));
  const edits = JSON.parse(
    fs.readFileSync(
      path.join(root, "benchmarks/internal/real_text_trace_edits.json"),
      "utf8"
    )
  ).edits;
  for (const edit of edits) {
    if (edit[2] !== undefined) {
      const before = edit[0] === 0 ? null : list.at(edit[0] - 1);
      list = list.insertAfter(before, generator.generateAfter(before));
    } else list = list.delete(list.at(edit[0]));
  }
  const saved = list.save();
  const columns = ColumnarIdList.fromSaved(saved).toJSON();
  const binary = ColumnarIdList.load(columns).toBinary();
  const packed = BitPackedIdList.fromSaved(saved).toBinary();
  const formats = [
    "objects",
    "signed_count_objects",
    "columns_binary",
    "bitpacked_columns",
  ];
  const documents = 100;
  function state(format, doc) {
    const bunchIds = columns.bunchIds.map((_, i) =>
      id("doc-" + doc + "-bunch-" + i)
    );
    assert.equal(new Set(bunchIds).size, bunchIds.length);
    if (format === "objects")
      return saved.map((run, i) => ({
        ...run,
        bunchId: bunchIds[columns.bunchIndexes[i]],
      }));
    if (format === "signed_count_objects")
      return saved.map((run, i) => ({
        bunchId: bunchIds[columns.bunchIndexes[i]],
        startCounter: run.startCounter,
        count: run.isDeleted ? -run.count : run.count,
      }));
    const value = format === "columns_binary" ? binary : packed;
    return {
      version: value.version,
      bunchIds,
      bunchIndexes: new Binary(value.bunchIndexes),
      startCounters: new Binary(value.startCounters),
      signedCounts: new Binary(value.signedCounts),
    };
  }
  function verify(format, actual, doc) {
    let restored;
    if (format === "objects") restored = actual;
    else if (format === "signed_count_objects")
      restored = actual.map(({ bunchId, startCounter, count }) => ({
        bunchId,
        startCounter,
        count: Math.abs(count),
        isDeleted: count < 0,
      }));
    else {
      const bytes = { ...actual };
      for (const key of ["bunchIndexes", "startCounters", "signedCounts"])
        bytes[key] = require("node:buffer").Buffer.from(actual[key].value());
      restored = (
        format === "columns_binary" ? ColumnarIdList : BitPackedIdList
      )
        .loadBinary(bytes)
        .toSaved();
    }
    // JSON comparison avoids different JS realm prototypes in mongosh.
    assert.equal(
      JSON.stringify(restored),
      JSON.stringify(state("objects", doc))
    );
    assert.equal(
      JSON.stringify(IdList.load(restored).save()),
      JSON.stringify(restored)
    );
  }
  const entries = [];
  for (const compressor of ["none", "snappy", "zstd"]) {
    for (const format of formats) {
      const name = compressor + "_" + format;
      if (!existing.includes(name))
        await bench.createCollection(name, {
          storageEngine: {
            wiredTiger: { configString: "block_compressor=" + compressor },
          },
        });
      const collection = bench.getCollection(name);
      const already = await collection.countDocuments({});
      assert(already === 0 || already === documents, "Refuse partial fixture");
      for (let offset = already; offset < documents; offset += 5) {
        await collection.insertMany(
          Array.from({ length: 5 }, (_, i) => ({
            _id: offset + i,
            state: state(format, offset + i),
          }))
        );
      }
      assert.equal(await collection.countDocuments({}), documents);
      for (const doc of [0, documents - 1])
        verify(format, (await collection.findOne({ _id: doc })).state, doc);
      const compact = await bench.runCommand({
        compact: name,
        freeSpaceTargetMB: 1,
      });
      assert.equal(compact.ok, 1);
      entries.push({ name, compressor, format, compact });
      print("FINISHED " + name);
    }
  }
  await admin.runCommand({ fsync: 1, lock: true });
  try {
    const results = [];
    for (const entry of entries) {
      const row = (
        await bench
          .getCollection(entry.name)
          .aggregate([{ $collStats: { storageStats: { scale: 1 } } }])
          .toArray()
      )[0].storageStats;
      const wt = row.wiredTiger;
      assert(
        wt.creationString.includes("block_compressor=" + entry.compressor)
      );
      const table = wt.uri.split(":").pop();
      assert(/^collection[-a-zA-Z0-9_]+$/.test(table));
      const fileBytes = fs.statSync(
        path.join(expectedPath, table + ".wt")
      ).size;
      assert.equal(fileBytes, Number(row.storageSize));
      results.push({
        ...entry,
        count: Number(row.count),
        logicalBytes: Number(row.size),
        storageBytes: Number(row.storageSize),
        fileBytes,
        freeBytes: Number(row.freeStorageSize || 0),
        indexBytes: Number(row.totalIndexSize),
        checkpointBytes: Number(wt["block-manager"]["checkpoint size"]),
      });
    }
    print(
      "SUMMARY " +
        JSON.stringify({
          version: await bench.version(),
          documentsPerCollection: documents,
          runsPerDocument: saved.length,
          idsPerDocument: columns.bunchIds.length,
          edits: edits.length,
          results,
        })
    );
  } finally {
    await admin.runCommand({ fsyncUnlock: 1 });
  }
})();
